{
  "name": "portfolio",
  "version": "0.1.0",
  "description": "jeshwinprince.com on Fastly Compute",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@fastly/js-compute": "^4.3.0"
  },
  "devDependencies": {
    "@fastly/cli": "^17.2.0",
    "@fastly/compute-js-static-publish": "8.0.2"
  },
  "scripts": {
    "build": "js-compute-runtime ./src/index.js ./bin/main.wasm",
    "test": "node --test src/",
    "dev:publish": "compute-js-static-publish publish-content --local",
    "dev:start": "fastly compute serve",
    "fastly:deploy": "fastly compute publish",
    "fastly:publish": "compute-js-static-publish publish-content"
  }
}
